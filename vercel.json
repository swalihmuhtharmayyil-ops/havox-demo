{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "havoxinternational.com"
        }
      ],
      "destination": "https://www.havoxinternational.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/about",
      "destination": "/pages/style-guide"
    },
    {
      "source": "/programs",
      "destination": "/pages/changelog"
    },
    {
      "source": "/faq",
      "destination": "/pages/instructions"
    },
    {
      "source": "/terms",
      "destination": "/pages/license"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://d3e54v103j8qbb.cloudfront.net https://cdn.prod.website-files.com; script-src-elem 'self' 'unsafe-inline' https://d3e54v103j8qbb.cloudfront.net https://cdn.prod.website-files.com; style-src 'self' 'unsafe-inline' https://cdn.prod.website-files.com; img-src 'self' data: blob: https://cdn.prod.website-files.com; font-src 'self' data:; media-src 'self' blob:; connect-src 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
